<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal protection-level network permission for optional HTTPS release metadata check only -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Googlebook OS / ChromeOS / Large-Screen Desktop Windowing & Hardware Features -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false" />
    <uses-feature
        android:name="android.software.freeform_window_management"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GravityEdit"
        android:usesCleartextTraffic="false"
        tools:targetApi="35">

        <!-- Enable Googlebook OS / Freeform multi-window drag & resize optimization -->
        <meta-data
            android:name="WindowManagerPreference:FreeformWindowSize"
            android:value="maximize" />
        <meta-data
            android:name="WindowManagerPreference:FreeformWindowOrientation"
            android:value="landscape" />

        <!-- Per-app language service support for Android 12L and earlier alongside API 33+ -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">

            <layout
                android:defaultHeight="820dp"
                android:defaultWidth="1280dp"
                android:gravity="center"
                android:minHeight="480dp"
                android:minWidth="360dp" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Scoped Storage / SAF Content URI Text, JSON, XML, Markdown & PowerShell Intent Filter -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/x-powershell" />
            </intent-filter>
        </activity>
    </application>

</manifest>
